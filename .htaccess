<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle API requests
  RewriteRule ^api/inquiry/?$ api/inquiry.php [L,QSA]
  RewriteRule ^api/sick-leaves/inquiry/?$ api/inquiry.php [L,QSA]
  RewriteRule ^api/sick-leaves/sync/?$ api/sick-leaves.php?sync=1 [L,QSA]
  RewriteRule ^api/sick-leaves/([^/]+)/?$ api/sick-leaves.php?id=$1 [L,QSA]
  RewriteRule ^api/sick-leaves/?$ api/sick-leaves.php [L,QSA]
  RewriteRule ^inquiry\.php/?$ inquiry.php [L,QSA]
  RewriteRule ^slenquiry\.php/?$ slenquiry.php [L,QSA]

  # Allow direct access to real files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, apikey, x-token"
</IfModule>
